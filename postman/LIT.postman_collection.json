        {
          "name": "05 내 계정 확인",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.test(\"학생 권한\", () => pm.expect(pm.response.json().role).to.eql(\"STUDENT\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 평가 생성",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/teacher/evaluations",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacherAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"답안·AI·제출 테스트\",\n  \"expiresInMinutes\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"evaluationId\", data.id);",
                  "pm.collectionVariables.set(\"pin\", data.pin);"
                ]
              }
            }
          ]
        },
