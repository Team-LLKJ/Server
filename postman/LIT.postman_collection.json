              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aiPolicy\": \"HINT_ONLY\",\n  \"questions\": [\n    {\n      \"position\": 1,\n      \"title\": \"덧셈\",\n      \"content\": \"2+2의 값과 그 이유를 설명하세요.\"\n    },\n    {\n      \"position\": 2,\n      \"title\": \"생각 정리\",\n      \"content\": \"이 문제를 해결한 과정을 설명하세요.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"questionId\", data.questions[0].id);",
                  "pm.collectionVariables.set(\"questionId2\", data.questions[1].id);"
                ]
              }
            }
          ]
        },
