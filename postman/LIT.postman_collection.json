              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"답안·AI·제출 테스트\",\n  \"expiresInMinutes\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"evaluationId\", data.id);",
                  "pm.collectionVariables.set(\"pin\", data.pin);"
                ]
              }
            }
          ]
        },
