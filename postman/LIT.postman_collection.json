  "item": [
    {
      "name": "전체 흐름 (테스트)",
      "item": [
        {
          "name": "01 교사 가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signup/teacher",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{teacherUsername}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{teacherUsername}}@example.test\",\n  \"name\": \"테스트교사\",\n  \"school\": \"{{school}}\",\n  \"inviteCode\": \"{{bootstrapInviteCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 16);",
                  "pm.collectionVariables.set(\"teacherUsername\", \"teacher_\" + suffix);",
                  "pm.collectionVariables.set(\"password\", pm.variables.replaceIn(\"{{$guid}}\") + \"aA1!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 교사 로그인",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{teacherUsername}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"teacherAccessToken\", data.accessToken);",
                  "pm.collectionVariables.set(\"teacherRefreshToken\", data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 내 계정 확인",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacherAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.test(\"교사 권한\", () => pm.expect(pm.response.json().role).to.eql(\"TEACHER\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 평가 생성",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
