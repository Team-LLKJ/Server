{
  "info": {
    "name": "LIT 전체 평가 API",
    "description": "README의 Postman 실행 안내를 먼저 확인하세요. LIT_AI_PROVIDER=stub이면 외부 API 비용 없이 실행됩니다. 01번부터 순서대로 실행하며 응답 ID와 토큰은 자동 저장됩니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "teacherKey",
      "value": "test",
      "type": "string"
    },
    {
      "key": "evaluationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pin",
      "value": "",
      "type": "string"
    },
    {
      "key": "participantToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "participantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "aiRequestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 평가 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/teacher/evaluations",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherKey}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"답안·AI·제출 테스트\",\n  \"expiresInMinutes\": 60\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "const data = pm.response.json();",
              "pm.collectionVariables.set(\"evaluationId\", data.id);",
              "pm.collectionVariables.set(\"pin\", data.pin);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 문항 및 AI 정책 설정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/teacher/evaluations/{{evaluationId}}/questions",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherKey}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"aiPolicy\": \"HINT_ONLY\",\n  \"questions\": [\n    {\n      \"position\": 1,\n      \"title\": \"덧셈\",\n      \"content\": \"2+2의 값과 그 이유를 설명하세요.\"\n    },\n    {\n      \"position\": 2,\n      \"title\": \"생각 정리\",\n      \"content\": \"이 문제를 해결한 과정을 설명하세요.\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "const data = pm.response.json();",
              "pm.collectionVariables.set(\"questionId\", data.questions[0].id);",
              "pm.collectionVariables.set(\"questionId2\", data.questions[1].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 PIN 확인",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/participation/verify?pin={{pin}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 학생 등록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/participation/join",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pin\": \"{{pin}}\",\n  \"nickname\": \"테스트학생\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "const data = pm.response.json();",
              "pm.collectionVariables.set(\"participantToken\", data.participantToken);",
              "pm.collectionVariables.set(\"participantId\", data.participantId);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 교사 평가 시작",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/teacher/evaluations/{{evaluationId}}/start",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherKey}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 학생 문항과 답안 목록",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/questions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 첫 문항 답안 저장",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/questions/{{questionId}}/answer",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"물체 두 개에 두 개를 더하면 네 개가 됩니다.\",\n  \"expectedVersion\": 0,\n  \"source\": \"DIRECT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 다른 문항 선택",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/questions/{{questionId2}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 첫 문항으로 돌아와 답안 유지 확인",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/questions/{{questionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test(\"이전 답안 유지\", () => pm.expect(pm.response.json().answer.version).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 AI 질문",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/questions/{{questionId}}/ai/questions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{aiRequestId}}\",\n  \"text\": \"답안을 더 명확히 설명하려면 어떤 개념을 확인해야 하나요?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"aiRequestId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test(\"응답 완료\", () => pm.expect(pm.response.json().state).to.eql(\"COMPLETED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 AI 참고 후 답안 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/questions/{{questionId}}/answer",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"두 개씩 두 묶음을 합치면 모두 네 개이므로 2+2=4입니다.\",\n  \"expectedVersion\": 1,\n  \"source\": \"AI_REFERENCED\",\n  \"aiRequestId\": \"{{aiRequestId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 본인 대화 기록 조회",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/conversations?afterId=0&limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 본인 학습 과정 기록 조회",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/learning-events?afterId=0&limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 제출 미리 확인",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/submission-preview"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "const data = pm.response.json();",
              "pm.collectionVariables.set(\"reviewToken\", data.reviewToken);",
              "pm.test(\"두 번째 문항 미작성 안내\", () => pm.expect(data.blankQuestionIds).to.include(pm.collectionVariables.get(\"questionId2\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 제출 확정",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/submission",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reviewToken\": \"{{reviewToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 확정 제출 조회",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/submission"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "17 제출 완료 화면 상태",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Participant-Token",
            "value": "{{participantToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/evaluations/{{evaluationId}}/state"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test(\"제출 완료 화면\", () => pm.expect(pm.response.json().screen).to.eql(\"SUBMITTED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 교사 학습 과정 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/teacher/evaluations/{{evaluationId}}/participants/{{participantId}}/learning-events?afterId=0&limit=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{teacherKey}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"요청 성공\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    }
  ]
}
