  "item": [
    {
      "name": "전체 흐름 (테스트)",
      "item": [
        {
          "name": "01 교사 가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signup/teacher",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{teacherUsername}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{teacherUsername}}@example.test\",\n  \"name\": \"테스트교사\",\n  \"school\": \"{{school}}\",\n  \"inviteCode\": \"{{bootstrapInviteCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 16);",
                  "pm.collectionVariables.set(\"teacherUsername\", \"teacher_\" + suffix);",
                  "pm.collectionVariables.set(\"studentUsername\", \"student_\" + suffix);",
                  "pm.collectionVariables.set(\"password\", pm.variables.replaceIn(\"{{$guid}}\") + \"aA1!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 교사 로그인",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{teacherUsername}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"요청 성공\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"teacherAccessToken\", data.accessToken);",
                  "pm.collectionVariables.set(\"teacherRefreshToken\", data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 학생 가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signup/student",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentUsername}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{studentUsername}}@example.test\",\n  \"name\": \"테스트학생\",\n  \"school\": \"{{school}}\",\n  \"grade\": 1,\n  \"classNumber\": 1,\n  \"studentNumber\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
