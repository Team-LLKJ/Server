            "body": {
              "mode": "raw",
              "raw": "{\n  \"aiPolicy\": \"HINT_ONLY\",\n  \"questions\": [\n    {\n      \"position\": 1,\n      \"title\": \"덧셈\",\n      \"content\": \"2+2의 값과 그 이유를 설명하세요.\"\n    },\n    {\n      \"position\": 2,\n      \"title\": \"생각 정리\",\n      \"content\": \"이 문제를 해결한 과정을 설명하세요.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
