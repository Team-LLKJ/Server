{
  "info": {
    "name": "LIT 전체 평가 API",
    "description": "교사 초대 가입·학생 일반 가입·공통 Bearer 인증을 사용하는 LIT API. README 참고. 전체 흐름 폴더만 실행하세요. 최초 교사 초대 코드를 bootstrapInviteCode에 입력해야 합니다. SMTP 재설정 폴더는 별도 실행입니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "school",
      "value": "테스트학교",
      "type": "string"
    },
    {
      "key": "bootstrapInviteCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "evaluationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pin",
      "value": "",
      "type": "string"
    },
    {
      "key": "participantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "aiRequestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "nextInviteCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "newPassword",
      "value": "",
