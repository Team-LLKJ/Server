      "type": "string"
    },
    {
      "key": "bootstrapInviteCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "evaluationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pin",
      "value": "",
      "type": "string"
    },
    {
      "key": "participantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "aiRequestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewToken",
      "value": "",
