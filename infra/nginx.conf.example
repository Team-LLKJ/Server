# For the deployed Web SPA, configure-report-mjs-nginx.py preserves API locations and adds text/javascript for .mjs.
# SSE responses use X-Accel-Buffering: no and keepalive comments.
# Replace YOUR_API_DOMAIN. Use Certbot to enable HTTPS after DNS points to EC2.
server {
    listen 80;
    server_name YOUR_API_DOMAIN;
    client_max_body_size 8m;
    location / {
        proxy_pass http://127.0.0.1:5174;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 70s;
        proxy_send_timeout 70s;
    }
}
