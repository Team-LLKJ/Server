# Copy to /opt/lit/app.env on the server (chmod 600). Never commit actual values.
LIT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LIT_AI_TIMEOUT_SECONDS=45
DATABASE_USER=sa
DATABASE_PASSWORD=
# Public HTTPS address of the FRONTEND student join page, not this API.
LIT_JOIN_BASE_URL=https://YOUR_FRONTEND_DOMAIN/join
# Exact browser origins, comma-separated, without trailing slash. Leave blank for same-origin proxy.
LIT_CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
# Only needed to register the initial teacher invite on a new empty database.
LIT_BOOTSTRAP_TEACHER_INVITE=
LIT_BOOTSTRAP_SCHOOL=

# 평가 종료 후 자동 제출된 학생의 마지막 저장을 받는 유예 시간(초), 0이면 끔
LIT_EVALUATION_END_GRACE_SECONDS=0
