# Copy to /opt/lit/app.env on the server (chmod 600). Never commit actual values.
LIT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LIT_AI_TIMEOUT_SECONDS=45
DATABASE_USER=sa
DATABASE_PASSWORD=
# Public HTTPS address of the FRONTEND student join page, not this API.
LIT_JOIN_BASE_URL=https://YOUR_FRONTEND_DOMAIN/join
# Exact browser origins, comma-separated, without trailing slash. Leave blank for same-origin proxy.
LIT_CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
# Signup email: authenticated STARTTLS SMTP. Use provider-issued credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
LIT_MAIL_FROM=
# HTTPS frontend reset page; no query/fragment. Frontend reads #token=...
LIT_PASSWORD_RESET_URL=https://YOUR_FRONTEND_DOMAIN/reset-password

# 평가 종료 후 자동 제출된 학생의 마지막 저장을 받는 유예 시간(초), 0이면 끔
LIT_EVALUATION_END_GRACE_SECONDS=0

# 행동 근거 기반 채점 작업 검사 간격(ms). Gemini 설정을 재사용합니다.
LIT_PROCESS_GRADING_INTERVAL_MS=3000
# 채점용 AI 판정(docs/AI_JUDGE.md). Gemini 키는 학생 대화용과 다른 Google 프로젝트에서 용도마다 하나씩 받습니다.
LIT_GRADING_JUDGE_ENABLED=false
ANTHROPIC_API_KEY=
LIT_GRADING_JUDGE_GEMINI_ANALYSIS_KEY=
LIT_GRADING_JUDGE_GEMINI_RUBRIC_KEY=
LIT_GRADING_JUDGE_GEMINI_MODEL=gemini-3.1-flash-lite
# 키별 분당·하루 호출 한도(프로젝트 실제 한도에 맞춤, 0이면 제한 없음)
LIT_GRADING_JUDGE_ANALYSIS_RPM=15
LIT_GRADING_JUDGE_ANALYSIS_RPD=1000
LIT_GRADING_JUDGE_RUBRIC_RPM=15
LIT_GRADING_JUDGE_RUBRIC_RPD=1000
# 평가가 끝나기 전에는 채점 결과를 내려 주지 않음
LIT_GRADING_RESULTS_AFTER_END=true
